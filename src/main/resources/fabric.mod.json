	"authors": [
		"Vibzz"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC-BY-NC-ND-4.0",
	"icon": "assets/renderdistancehotkeys/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.vibzz.renderdistancehotkeys.Renderdistancehotkeys"
		]
	},
	"mixins": [
		"renderdistancehotkeys.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
